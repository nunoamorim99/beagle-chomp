# Beagle Chomp API — environment variables.
#
# Copy to server/.env for local runs OUTSIDE docker-compose (compose sets these
# itself). In production these are set in the Dokploy UI — never committed to
# git (STACK.md §2.6).

# development | production | test
NODE_ENV=development

# The port the process listens on. docker-compose maps host 3001 → container
# 3000 (host 3000 is used by another project on this machine).
PORT=3000

# This project's OWN database on the shared Postgres container (STACK.md §1:
# one Postgres, one database per project).
# Local (docker-compose maps Postgres to host port 5433):
DATABASE_URL=postgres://beaglechomp:devpassword@localhost:5433/beaglechomp
# Production example (set the real value in Dokploy):
# DATABASE_URL=postgres://beaglechomp:CHANGEME@postgres:5432/beaglechomp

# Comma-separated CORS allowlist — an explicit list, NEVER "*" (STACK.md §2.5).
# Origin = scheme + host + port only; paths are not part of an Origin header.
# http://localhost:5173 is allowed automatically outside production.
CORS_ORIGINS=https://beaglechomp.nunoamorim.dev

# Bearer token lifetime, in days (sliding).
TOKEN_TTL_DAYS=90

# debug | info | warn | error
LOG_LEVEL=info

# --- Request metrics (IDEA-039 P1) -----------------------------------------
# The API times every request and writes a p95-per-route table to the container
# log. None of these need setting; the defaults are the intended production
# values. Dokploy shows the log under the service's Logs tab.

# How often the p95 table is written. The table is skipped entirely when the
# window saw no traffic, so an idle API stays quiet.
METRICS_LOG_INTERVAL_MIN=10

# A single request at or above this logs a [slow] line immediately. 1000ms
# rather than something tighter because a real login spends time in argon2 by
# design — a 200ms threshold here would fire on every sign-in.
SLOW_REQUEST_MS=1000

# A single SQL statement at or above this logs a [slow-query] line (statement
# text only, never the parameters). 200ms deliberately: STACK.md §6 names "a
# query measurably exceeds ~200 ms" as a trigger for adding Redis, so this line
# is the evidence that the trigger fired. Minimum 1 — there is no "0 = log
# everything" mode, on purpose.
SLOW_QUERY_MS=200

# Bearer token for GET /metrics (the JSON form of the same table).
# LEAVE UNSET and the endpoint does not exist at all — the path 404s like any
# unknown one. Set it only when you want to point a graph or a curl at it, and
# make it long and random; 16 characters is the enforced minimum.
# METRICS_TOKEN=

# --- Session retention (IDEA-039 P2) ---------------------------------------
# Days an ABANDONED game session is kept before deletion. 0 disables the purge.
# ONLY 'abandoned' rows are ever eligible: 'accepted' rows ARE the All-runs
# leaderboard, and deleting a 'rejected' row would cascade away its entry in the
# score_rejections anti-cheat audit log. At today's volume a 90-day window
# deletes nothing — it is meant to be inert until the table actually grows.
SESSION_RETENTION_DAYS=90
